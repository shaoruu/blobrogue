# blobrogue-control environment — required variable NAMES only (NO real values here).
# On the Hetzner box these live in a .env readable only by the deploy user (chmod 600). The
# control service is loopback-only (127.0.0.1:8091); the admin.create.town panel proxies to it.
# These secrets are SEPARATE from the game server's GS_AUTH_SECRET — control and game never share
# credentials.

# Bind (loopback only; never expose publicly — nginx/panel proxy is the only reachable path).
BRC_HOST=127.0.0.1
BRC_PORT=8091

# HMAC secret the admin panel signs short-lived ops tokens with (scope must include
# "blobrogue:ops"). REQUIRED in production — the service refuses to start without it.
BRC_ADMIN_TOKEN_SECRET=

# HMAC secret for action-bound confirmation tokens (deploy/restart/rollback). REQUIRED in prod.
BRC_CONFIRM_TOKEN_SECRET=

# Required audience claim on both token types.
BRC_TOKEN_AUDIENCE=blobrogue-control

# Reject admin tokens whose (exp - iat) exceeds this many seconds (short-lived only).
BRC_ADMIN_TOKEN_MAX_TTL_SEC=900

# CSV of allowed Origin header values (the admin panel origin). Empty = allow any (the token is
# still the real gate); pin this in production. Server-to-server requests with no Origin pass.
BRC_ALLOWED_ORIGINS=

# Token-bucket rate limit (per remote).
BRC_RATE_CAPACITY=30
BRC_RATE_REFILL_PER_SEC=1

# Immutable releases root: releases/<id>, current -> ..., staging -> ...
BRC_RELEASES_ROOT=/opt/blobrogue-gs

# Good releases retained for rollback (older pruned; current/staging never pruned).
BRC_RETAINED_RELEASES=5

# Durable operations + append-only audit log directory (chmod 700).
BRC_STATE_DIR=/opt/blobrogue-control/state

# Max log records returnable via GET /v1/logs.
BRC_LOG_TAIL_MAX=500

# Game server loopback endpoints the control plane reads/verifies against.
BRC_GS_BASE_URL=http://127.0.0.1:8090
BRC_GS_WS_URL=ws://127.0.0.1:8090/ws

# Optional: gs pm2 out-log path to back GET /v1/logs (redacted). Leave unset to disable log tail.
BRC_GS_LOG_OUT_FILE=/var/log/blobrogue-gs/out.log

# OPTIONAL: equal to the box GS_AUTH_SECRET. When set, deploy VERIFY performs a FULL synthetic
# join (mints a short-lived ticket for a dedicated synthetic player, loopback only) instead of a
# credential-free WS-liveness check. Never used to accept inbound control requests. Leave unset to
# keep the control/game credential boundary maximally strict.
BRC_GS_SYNTHETIC_TICKET_SECRET=

# LOCAL DEV ONLY. When 1 AND NODE_ENV != production, accepts `Bearer dev:<actor>` and a
# `dev:` confirm header so the panel/dev can drive the API without minting real tokens.
# Hard-disabled in production regardless of this value.
BRC_ALLOW_DEV_AUTH=
