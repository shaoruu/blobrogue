{
  "name": "blobrogue-gs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "blobrogue authoritative game server (Stage B): imports the shared src/sim stepWorld and runs it over WebSocket.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/server/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/server.test.ts",
    "harness": "tsx harness/loadtest.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2"
  }
}
