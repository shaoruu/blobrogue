# blobrogue game server environment — required variable NAMES only (NO real values here).
# On the Hetzner box these live in a .env readable only by the deploy user (chmod 600); they
# are loaded into process.env by pm2 / the shell. GS_AUTH_SECRET can be rotated without any
# client change (it is server<->minter only).

# HMAC secret used to verify auth tickets minted by the trusted party (a Convex action in
# production). REQUIRED in production — the server refuses to start without it.
GS_AUTH_SECRET=

# Convex deployment URL (accounts/auth/persistence). Used by the ticket minter, not the WS loop.
CONVEX_URL=

# Bind + protocol (defaults shown). The port is loopback-only; nginx terminates wss on 443 and
# reverse-proxies to it. Never expose this port publicly.
PORT=8090
GS_HOST=127.0.0.1
GS_WS_PATH=/ws

# Logging: debug|info|warn|error (default info). Never log per-tick/per-message at info.
GS_LOG_LEVEL=info

# LOCAL DEV ONLY. When set to 1 AND NODE_ENV is not "production", the server accepts
# `dev:<playerId>` tickets and exposes GET /dev-ticket for local browser tabs. Hard-disabled in
# production regardless of this value. Leave UNSET (or 0) for any real deployment.
GS_ALLOW_DEV_AUTH=

# Optional tuning (defaults are sensible; shown for reference).
# GS_MAX_CONNS_PER_IP=16
# GS_MAX_MSGS_PER_SEC=120
# GS_MAX_INPUT_QUEUE=32
# GS_JOIN_TIMEOUT_MS=5000
# GS_HEARTBEAT_MS=5000
# GS_HEARTBEAT_MISSES=3
# Per-client snapshot interest radius in px. DEFAULT 0 (off — full world snapshots) since the
# Sev-0 room-divergence incident; re-enable to 1100 ONLY per the rollout criteria in
# MULTIPLAYER.md §7 (coherence suite green + staged two-client verification).
# GS_INTEREST_RADIUS=0

# Reconnect grace: how long an unexpectedly-disconnected player's body/state is reserved
# (absent + safe) before the authoritative leave applies. Seats are in-memory — a server
# restart drops them (documented in MULTIPLAYER.md §7). 0 disables resume entirely.
# GS_RESUME_GRACE_MS=25000
