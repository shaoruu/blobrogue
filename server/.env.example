# blobrogue game server environment — required variable NAMES only (NO real values here).
# On the Hetzner box these live in a .env readable only by the deploy user (chmod 600); they
# are loaded into process.env by pm2 / the shell. GS_AUTH_SECRET can be rotated without any
# client change (it is server<->minter only).

# HMAC secret used to verify auth tickets minted by the trusted party (a Convex action in
# production). REQUIRED in production — the server refuses to start without it.
GS_AUTH_SECRET=

# Dedicated HMAC secret for short-lived control-plane world rescue actions. REQUIRED in
# production. Set BRC_GS_CONTROL_SECRET to the same value in the control service; do not reuse
# GS_AUTH_SECRET or GS_RECEIPT_SECRET.
GS_CONTROL_SECRET=

# Distinct HMAC secret used only for authoritative run-completion receipts. Set the identical
# value as GS_RECEIPT_SECRET in Convex; never reuse GS_AUTH_SECRET.
GS_RECEIPT_SECRET=

# Full Convex HTTP action URL receiving signed completion receipts.
# Example: https://<deployment>.convex.site/gs/run-completion
GS_CONVEX_RECEIPT_URL=

# Full Convex HTTP action URL for fail-closed current-generation admission checks.
# Example: https://<deployment>.convex.site/gs/admission
GS_CONVEX_ADMISSION_URL=

# Durable admission ledger. Must live outside release directories and survive PM2 restarts.
GS_GENERATION_STATE_PATH=/var/lib/blobrogue/generation-admission.json

# Admin-created run snapshots. Files contain reconnect credentials, use mode 0600, and must live
# outside release directories. Production defaults to this path when the variable is omitted.
GS_RUN_SNAPSHOT_DIR=/var/lib/blobrogue/run-snapshots

# Bind + protocol (defaults shown). The port is loopback-only; nginx terminates wss on 443 and
# reverse-proxies to it. Never expose this port publicly.
PORT=8090
GS_HOST=127.0.0.1
GS_WS_PATH=/ws

# Logging: debug|info|warn|error (default info). Never log per-tick/per-message at info.
GS_LOG_LEVEL=info

# LOCAL DEV ONLY. When set to 1 AND NODE_ENV is not "production", the server accepts
# `dev:<playerId>` tickets and exposes GET /dev-ticket for local browser tabs. Hard-disabled in
# production regardless of this value. Leave UNSET (or 0) for any real deployment.
GS_ALLOW_DEV_AUTH=

# Optional tuning (defaults are sensible; shown for reference).
# GS_MAX_CONNS_PER_IP=16
# GS_MAX_MSGS_PER_SEC=120
# GS_MAX_INPUT_QUEUE=32
# GS_JOIN_TIMEOUT_MS=5000
# Heartbeat ping cadence. 2s keeps a healthy link inside the 3s absence-detection window
# (see GS_ABSENCE_DETECT_MS); 3 misses still close a dead socket in ~6s.
# GS_HEARTBEAT_MS=2000
# GS_HEARTBEAT_MISSES=3
# Per-client snapshot interest radius in px. DEFAULT 0 (off — full world snapshots) since the
# Sev-0 room-divergence incident; re-enable to 1100 ONLY per the rollout criteria in
# MULTIPLAYER.md §7 (coherence suite green + staged two-client verification).
# GS_INTEREST_RADIUS=0

# Reconnect grace: how long an unexpectedly-disconnected player's body/state is reserved
# (absent + safe) before the authoritative leave applies. 90s per the studio balance gate
# (docs/specs/blobrogue_STUDIO_BALANCE_GATE.md §6). Ordinary seats are in-memory; only runs
# explicitly captured through the admin snapshot action survive a restart. 0 disables resume.
# GS_RESUME_GRACE_MS=90000

# Silent-drop detection (balance gate §6): a connection with NO inbound traffic for this long
# has its body marked absent/safe immediately (without waiting for the heartbeat close); the
# next frame restores it. Heartbeat pongs arrive every GS_HEARTBEAT_MS (default 2000), so a
# healthy link can never trip it. 0 disables the fast path.
# GS_ABSENCE_DETECT_MS=3000
